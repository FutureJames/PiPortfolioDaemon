+/*
+	PortfolioServer extensions (SERVER.COM, a replacement for the Portfolio's
+	built-in server). The built-in server acknowledges these commands but
+	never replies, which is how they tell the two apart.
+*/
+#define POFO_INFO  0x40
+#define POFO_DIR   0x41
+#define POFO_DELETE 0x42
+#define POFO_MKDIR 0x43
+#define POFO_RMDIR 0x44
+#define POFO_FREE  0x45
+#define POFO_QUIT  0x4F
+#define EXIT_NOT_PORTFOLIOSERVER 3
+/* shown in the help text, so callers can tell this build from the original */
+#define POFO_PATCH_VERSION 1
+
+/*
+	Like receiveBlock(), but returns -1 instead of exiting if the Portfolio
+	is idle (sends 5A instead of A5): the built-in server ignoring a command.
+*/
+int receiveReply(unsigned char *pData, const int maxLen)
+{
+	unsigned int len, i;
+	unsigned char lenH, lenL;
+	unsigned char checksum = 0;
+	unsigned char byte;
+
+	sendByte('Z');
+	byte = receiveByte();
+	if (byte == 0x5A)
+		return -1;
+	if (byte != 0x0a5) {
+		fprintf(stderr, "Acknowledge ERROR (received %2X instead of A5)\n", byte);
+		exit(EXIT_FAILURE);
+	}
+
+	lenL = receiveByte();  checksum += lenL;
+	lenH = receiveByte();  checksum += lenH;
+	len = (lenH << 8) | lenL;
+	if (len > maxLen) {
+		fprintf(stderr, "Receive buffer too small (%d instead of %d bytes).\n", maxLen, len);
+		exit(EXIT_FAILURE);
+	}
+	for (i=0; i<len; i++) {
+		byte = receiveByte();
+		checksum += byte;
+		pData[i] = byte;
+	}
+	byte = receiveByte();
+	if ((unsigned char)(256 - byte) != checksum) {
+		fprintf(stderr, "checksum ERR %d %d\n", (unsigned char)(256 - byte), checksum);
+		exit(EXIT_FAILURE);
+	}
+	usleep(100);
+	sendByte((unsigned char)(256 - checksum));
+	return len;
+}
+
+static void notPortfolioServer(void)
+{
+	fflush(stdout);
+	fprintf(stderr, "No reply: the Portfolio is running its built-in server, not PortfolioServer.\n");
+	exit(EXIT_NOT_PORTFOLIOSERVER);
+}
+
+/*
+	Show PortfolioServer's version (-i)
+*/
+void serverInfo(void)
+{
+	unsigned char request[3] = { POFO_INFO, 0x00, 0x70 };
+	int len;
+
+	sendBlock(request, sizeof(request), VERB_ERRORS);
+	len = receiveReply(controlData, CONTROL_BUFSIZE);
+	if (len < 0)
+		notPortfolioServer();
+	if (len < 8 || controlData[0] != 0x20 || controlData[3] != 'P' || controlData[4] != 'S') {
+		fprintf(stderr, "Unexpected reply to the info command.\n");
+		exit(EXIT_FAILURE);
+	}
+	printf("PortfolioServer %d.%d, block size %d bytes.\n", controlData[5], controlData[6],
+	       controlData[1] | (controlData[2] << 8));
+}
+
+/*
+	List files and folders with attributes, size, date and time (-x).
+	One line per entry:  attributes size yyyy-mm-dd hh:mm:ss NAME
+	attributes are d (folder), r (read-only), h (hidden), s (system),
+	a (archive), or - where not set.
+*/
+void listFilesLong(const char * pattern)
+{
+	unsigned char request[82] = { POFO_DIR, 0x00, 0x70 };
+	int len, num, i;
+
+	printf("Fetching long directory listing for %s\n", pattern);
+	strncpy((char*)request+3, pattern, MAX_FILENAME_LEN);
+	sendBlock(request, sizeof(request), VERB_ERRORS);
+	len = receiveReply(payload, PAYLOAD_BUFSIZE);
+	if (len < 0)
+		notPortfolioServer();
+	if (len < 4) {
+		fprintf(stderr, "Unexpected reply to the long listing command.\n");
+		exit(EXIT_FAILURE);
+	}
+
+	num = payload[0] + (payload[1] << 8);
+	if (len < 4 + 22 * num) {
+		fprintf(stderr, "Long listing reply too short (%d bytes for %d entries).\n", len, num);
+		exit(EXIT_FAILURE);
+	}
+	if (num == 0)
+		printf("No files.\n");
+
+	for (i=0; i<num; i++) {
+		const unsigned char *e = payload + 4 + 22 * i;
+		unsigned int attr = e[0];
+		unsigned int time = e[1] | (e[2] << 8);
+		unsigned int date = e[3] | (e[4] << 8);
+		unsigned long size = e[5] | (e[6] << 8) | ((unsigned long)e[7] << 16) | ((unsigned long)e[8] << 24);
+		char name[14];
+
+		memcpy(name, e + 9, 13);
+		name[13] = '\0';
+		printf("%c%c%c%c%c %8lu %04u-%02u-%02u %02u:%02u:%02u %s\n",
+		       attr & 0x10 ? 'd' : '-', attr & 0x01 ? 'r' : '-',
+		       attr & 0x02 ? 'h' : '-', attr & 0x04 ? 's' : '-',
+		       attr & 0x20 ? 'a' : '-', size,
+		       (date >> 9) + 1980, (date >> 5) & 15, date & 31,
+		       time >> 11, (time >> 5) & 63, (time & 31) * 2, name);
+	}
+	if (payload[2] & 1)
+		printf("(More entries than fit in one reply: the listing is incomplete.)\n");
+}
+
+static const char * dosError(int code)
+{
+	switch (code) {
+	case 0x02: return "file not found";
+	case 0x03: return "path not found";
+	case 0x05: return "access denied (read-only, not empty, or exists)";
+	case 0x0F: return "invalid drive";
+	case 0x10: return "is the current directory";
+	default:   return "failed";
+	}
+}
+
+/*
+	Delete a file (-e), make a folder (-m) or remove an empty folder (-k).
+	Returns 0 on success, 1 on failure.
+*/
+int pathCommand(unsigned char code, const char * path)
+{
+	unsigned char request[82] = { 0, 0x00, 0x70 };
+	const char * done = code == POFO_DELETE ? "Deleted" :
+	                    code == POFO_MKDIR ? "Made folder" : "Removed folder";
+	const char * verb = code == POFO_DELETE ? "delete" :
+	                    code == POFO_MKDIR ? "make folder" : "remove folder";
+	int len, err;
+
+	request[0] = code;
+	strncpy((char*)request+3, path, MAX_FILENAME_LEN);
+	sendBlock(request, sizeof(request), VERB_ERRORS);
+	len = receiveReply(controlData, CONTROL_BUFSIZE);
+	if (len < 0)
+		notPortfolioServer();
+	if (len < 3) {
+		fprintf(stderr, "Unexpected reply.\n");
+		exit(EXIT_FAILURE);
+	}
+	if (controlData[0] == 0x20) {
+		printf("%s %s\n", done, path);
+		return 0;
+	}
+	err = controlData[1] | (controlData[2] << 8);
+	fflush(stdout);
+	fprintf(stderr, "Cannot %s %s: %s (DOS error %d)\n", verb, path, dosError(err), err);
+	return 1;
+}
+
+/*
+	Show free and total space on a drive (-s). Returns 0 on success.
+*/
+int freeSpace(const char * drive)
+{
+	unsigned char request[82] = { POFO_FREE, 0x00, 0x70 };
+	unsigned long freeBytes, totalBytes;
+	int len;
+
+	strncpy((char*)request+3, drive, MAX_FILENAME_LEN);
+	sendBlock(request, sizeof(request), VERB_ERRORS);
+	len = receiveReply(controlData, CONTROL_BUFSIZE);
+	if (len < 0)
+		notPortfolioServer();
+	if (len < 9) {
+		fprintf(stderr, "Unexpected reply.\n");
+		exit(EXIT_FAILURE);
+	}
+	if (controlData[0] != 0x20) {
+		int err = controlData[1] | (controlData[2] << 8);
+		fflush(stdout);
+		fprintf(stderr, "Cannot read the free space on %s: %s (DOS error %d)\n", drive, dosError(err), err);
+		return 1;
+	}
+	freeBytes = controlData[1] | (controlData[2] << 8) | ((unsigned long)controlData[3] << 16) | ((unsigned long)controlData[4] << 24);
+	totalBytes = controlData[5] | (controlData[6] << 8) | ((unsigned long)controlData[7] << 16) | ((unsigned long)controlData[8] << 24);
+	printf("%s %lu bytes free of %lu\n", drive, freeBytes, totalBytes);
+	return 0;
+}
+
+/*
+	Stop PortfolioServer (-q)
+*/
+void serverQuit(void)
+{
+	unsigned char request[3] = { POFO_QUIT, 0x00, 0x70 };
+	int len;
+
+	sendBlock(request, sizeof(request), VERB_ERRORS);
+	len = receiveReply(controlData, CONTROL_BUFSIZE);
+	if (len < 0)
+		notPortfolioServer();
+	if (len < 1 || controlData[0] != 0x20) {
+		fprintf(stderr, "Unexpected reply to the quit command.\n");
+		exit(EXIT_FAILURE);
+	}
+	printf("PortfolioServer stopped.\n");
+}
+
